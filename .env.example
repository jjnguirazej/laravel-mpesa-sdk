# --- M-Pesa (jjnguirazej/mpesa-sdk) ---
# Valores fictícios. Substitua pelas credenciais do portal https://developer.mpesa.vm.co.mz
# e nunca faça commit do ficheiro .env.

# Ambiente: sandbox (testes) ou production
MPESA_ENV=sandbox

# Opcional: substitui o host do ambiente (apenas o nome do host, sem https://)
# MPESA_API_HOST=

# Chave de API e chave pública (base64 ou PEM) fornecidas pela Vodacom
MPESA_API_KEY=sua-chave-de-api
MPESA_PUBLIC_KEY=sua-chave-publica-base64

# Código do provedor de serviço (shortcode). 171717 é o código de testes do sandbox.
MPESA_SERVICE_PROVIDER_CODE=171717

# Cabeçalho Origin enviado em todos os pedidos
MPESA_ORIGIN=*

# Apenas para reversões
MPESA_INITIATOR_IDENTIFIER=seu-initiator-identifier
MPESA_SECURITY_CREDENTIAL=sua-security-credential

# Tempos limite em segundos
MPESA_TIMEOUT=120
MPESA_CONNECT_TIMEOUT=10
